# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (SQLite file for local development, or PostgreSQL URL)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/expensetracker?schema=public"

# JWT Secret for Authentication
JWT_SECRET=super-secret-jwt-key-for-expense-tracker-production-ready

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
# Set to "true" to enable long-polling in development when webhook URL is not publicly reachable
TELEGRAM_USE_POLLING=true

# Google Gemini AI Configuration (Free to use from Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional OpenAI AI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
