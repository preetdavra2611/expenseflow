// Prisma Schema for Telegram Expense Tracker

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  email            String?  @unique
  password         String?
  name             String
  telegramUserId   String?  @unique
  telegramUsername String?
  currency         String   @default("INR")
  currencySymbol   String   @default("₹")
  timezone         String   @default("Asia/Kolkata")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  recurring    RecurringTransaction[]
  updates      TelegramUpdate[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  type      String // "EXPENSE" or "INCOME"
  icon      String   @default("Tag")
  color     String   @default("#6366f1")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user         User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  recurring    RecurringTransaction[]

  @@unique([userId, name, type])
  @@map("categories")
}

model Transaction {
  id                String   @id @default(uuid())
  userId            String
  type              String // "EXPENSE" or "INCOME"
  amount            Float
  currency          String   @default("INR")
  categoryId        String
  description       String
  merchant          String?
  paymentMethod     String   @default("CASH") // "CASH", "UPI", "CARD", "NET_BANKING", "WALLET", "OTHER"
  transactionDate   DateTime @default(now())
  telegramMessageId String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([categoryId])
  @@index([transactionDate])
  @@map("transactions")
}

model Budget {
  id         String    @id @default(uuid())
  userId     String
  categoryId String
  amount     Float
  period     String    @default("MONTHLY") // "WEEKLY", "MONTHLY", "YEARLY"
  startDate  DateTime  @default(now())
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, period])
  @@map("budgets")
}

model RecurringTransaction {
  id            String   @id @default(uuid())
  userId        String
  categoryId    String
  amount        Float
  type          String   @default("EXPENSE") // "EXPENSE" or "INCOME"
  description   String
  merchant      String?
  paymentMethod String   @default("UPI")
  frequency     String   @default("MONTHLY") // "DAILY", "WEEKLY", "MONTHLY", "YEARLY"
  nextDate      DateTime
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("recurring_transactions")
}

model TelegramUpdate {
  id                   String   @id @default(uuid())
  updateId             String   @unique
  userId               String?
  pendingClarification String? // JSON stringified state for pending questions
  createdAt            DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("telegram_updates")
}
